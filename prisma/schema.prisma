generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUDIT & SOFT DELETE MODELS
// ============================================

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String // Table name
  entityId   String // Record ID
  oldValues  Json? // Before state
  newValues  Json? // After state
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model DeletedRecord {
  id           String    @id @default(cuid())
  entityType   String // Table name
  entityId     String // Original record ID
  data         Json // Complete snapshot of deleted record
  deletedById  String
  deletedAt    DateTime  @default(now())
  restoredAt   DateTime?
  restoredById String?
  deletedBy    User      @relation("DeletedBy", fields: [deletedById], references: [id])
  restoredBy   User?     @relation("RestoredBy", fields: [restoredById], references: [id])

  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("deleted_records")
}

// ============================================
// MASTER DATA MODELS (REFACTORED)
// ============================================

model UnitMaster {
  id          String    @id @default(cuid())
  name        String    @unique // e.g., "Piece", "Set", "sqm"
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  items       ItemMaster[]

  @@map("unit_masters")
}

model ItemMaster {
  id                String    @id @default(cuid())
  name              String    @unique
  category          String    // e.g., "Furniture", "Appliance", "Fixture"
  itemType          ItemType  @default(OTHER)
  unitId            String
  defaultPrice      Decimal?  @db.Decimal(10, 3)
  requiresPhotos    Boolean   @default(false)
  requiresChecklist Boolean   @default(true)
  tags              String[]  // e.g., ["fabric", "leather", "glass"]
  description       String?
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  // Nesting rules for catalog
  allowedParentTypes String[] @default([]) // Which MeasurementObjectType values can contain this item
  allowedChildTypes  String[] @default([]) // Which MeasurementObjectType values this item can contain
  canBeRootLevel     Boolean  @default(false) // Can this item be at root level (no parent)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  unit              UnitMaster @relation(fields: [unitId], references: [id])
  measurementObjects MeasurementObject[]

  @@map("item_masters")
}

model EquipmentMaster {
  id                String    @id @default(cuid())
  name              String    @unique
  description       String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  jobs              JobEquipment[]

  @@map("equipment_masters")
}

model MaterialMaster {
  id                String    @id @default(cuid())
  name              String    @unique
  description       String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  jobs              JobMaterial[]

  @@map("material_masters")
}

model RoomTypeMaster {
  id          String    @id @default(cuid())
  name        String    @unique // HALL, BEDROOM, KITCHEN, BATHROOM, etc.
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  @@map("room_type_masters")
}

model PaymentMethodMaster {
  id          String    @id @default(cuid())
  name        String    @unique // CASH, CARD, BANK_TRANSFER, etc.
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  @@map("payment_method_masters")
}

// ============================================
// SCHEDULING MODELS
// ============================================

model ScheduleEntry {
  id            String              @id @default(cuid())
  jobOrderId    String?
  siteVisitId   String?
  clientId      String
  type          ScheduleEntryType
  status        ScheduleEntryStatus @default(PLANNED)
  startDateTime DateTime
  endDateTime   DateTime
  locationText  String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  deletedById   String?

  jobOrder    JobOrder?  @relation(fields: [jobOrderId], references: [id])
  siteVisit   SiteVisit? @relation(fields: [siteVisitId], references: [id])
  client      Client     @relation(fields: [clientId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])
  assignees   ScheduleEntryAssignee[]
  reminders   ScheduleReminder[]

  @@index([jobOrderId])
  @@index([siteVisitId])
  @@index([clientId])
  @@index([startDateTime, endDateTime])
  @@map("schedule_entries")
}

model ScheduleEntryAssignee {
  id              String        @id @default(cuid())
  scheduleEntryId String
  employeeId      String
  roleInVisit     String        // e.g., "TECHNICIAN", "DRIVER", "SALES"
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  employee        User          @relation(fields: [employeeId], references: [id])

  @@unique([scheduleEntryId, employeeId])
  @@map("schedule_entry_assignees")
}

model ScheduleReminder {
  id              String        @id @default(cuid())
  scheduleEntryId String
  userId          String        // The user who wants the reminder
  offsetMinutes   Int           // e.g., -30 for 30 mins before
  channel         String        // e.g., "APP", "EMAIL", "SMS"
  isActive        Boolean       @default(true)
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])

  @@map("schedule_reminders")
}


// ============================================
// ENHANCED CORE MODELS WITH SOFT DELETE
// ============================================

model Client {
  id             String         @id @default(cuid())
  name           String
  phone          String
  alternatePhone String?
  whatsapp       String?
  email          String?
  type           ClientType     @default(INDIVIDUAL)
  source         ClientSource   @default(PHONE)
  status         ClientStatus   @default(NEW)
  isTemporary    Boolean        @default(false) // For "Cash Customer" etc.
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  convertedLeads Lead[] // Leads that were converted to this client
  jobOrders      JobOrder[]
  quotations     Quotation[]
  siteVisits     SiteVisit[]
  invoices       Invoice[]
  payments       Payment[]
  customerNotes  CustomerNote[]
  scheduleEntries ScheduleEntry[]
  measurements   Measurement[]

  @@index([phone])
  @@index([status])
  @@index([source])
  @@index([deletedAt])
  @@map("clients")
}

model Lead {
  id                    String      @id @default(cuid())
  name                  String
  phone                 String
  whatsapp              String?
  email                 String?
  source                ClientSource
  serviceInterest       String?
  notes                 String?
  status                LeadStatus  @default(NEW)
  isTemporary           Boolean     @default(false)
  duplicateCheckIgnored Boolean     @default(false)
  convertedToClientId   String? // Link to Client if converted
  createdById           String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?
  deletedById           String?
  createdBy             User        @relation(fields: [createdById], references: [id])
  convertedToClient     Client?     @relation(fields: [convertedToClientId], references: [id])
  quotations            Quotation[]
  siteVisits            SiteVisit[]

  @@index([phone])
  @@index([status])
  @@index([createdById])
  @@index([convertedToClientId])
  @@index([deletedAt])
  @@map("leads")
}

// ============================================
// NEW MODELS FOR STRUCTURED MEASUREMENT
// ============================================

model Measurement {
  id           String               @id @default(cuid())
  clientId     String
  siteVisitId  String?
  location     String?
  title        String
  notes        String?
  status       MeasurementStatus    @default(DRAFT)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteVisit    SiteVisit?           @relation(fields: [siteVisitId], references: [id])
  objects      MeasurementObject[]
  quotations   Quotation[]
  jobOrders    JobOrder[]
  photos       Photo[]

  @@index([clientId])
  @@index([siteVisitId])
  @@index([deletedAt])
  @@map("measurements")
}

model MeasurementObject {
  id              String               @id @default(cuid())
  measurementId   String
  parentObjectId  String?
  type            MeasurementObjectType
  name            String
  itemMasterId    String?
  // Size measurement (two modes: preset sizes OR custom dimensions)
  sizeMode        SizeMeasurementMode? // PRESET or DIMENSIONS
  size            ObjectSize?          // For preset mode (S, M, L, etc.)
  dimensionLength Decimal?             @db.Decimal(10, 2) // For dimensions mode
  dimensionWidth  Decimal?             @db.Decimal(10, 2)
  dimensionHeight Decimal?             @db.Decimal(10, 2)
  dimensionUnit   String?              // e.g., "cm", "m", "inch"
  // Other properties
  dirtLevel       DirtLevel?
  quantity        Int                  @default(1)
  notes           String?
  remarks         String?              // Additional remarks
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  deletedById     String?

  measurement     Measurement          @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  parent          MeasurementObject?   @relation("ObjectHierarchy", fields: [parentObjectId], references: [id])
  children        MeasurementObject[]  @relation("ObjectHierarchy")
  itemMaster      ItemMaster?          @relation(fields: [itemMasterId], references: [id])
  photos          Photo[]
  stains          MeasurementStain[]
  areasOfNotice   MeasurementAreaOfNotice[]
  media           MeasurementObjectMedia[]

  @@index([measurementId])
  @@index([parentObjectId])
  @@index([type])
  @@index([deletedAt])
  @@map("measurement_objects")
}

model MeasurementStain {
  id                    String            @id @default(cuid())
  measurementObjectId   String
  description           String
  notes                 String?
  photoUrl              String?           // Photo of the stain
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  deletedById           String?

  measurementObject     MeasurementObject @relation(fields: [measurementObjectId], references: [id], onDelete: Cascade)

  @@index([measurementObjectId])
  @@index([deletedAt])
  @@map("measurement_stains")
}

model MeasurementAreaOfNotice {
  id                    String            @id @default(cuid())
  measurementObjectId   String
  description           String
  notes                 String?
  photoUrl              String?           // Photo of the area
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  deletedById           String?

  measurementObject     MeasurementObject @relation(fields: [measurementObjectId], references: [id], onDelete: Cascade)

  @@index([measurementObjectId])
  @@index([deletedAt])
  @@map("measurement_areas_of_notice")
}

model MeasurementObjectMedia {
  id                    String            @id @default(cuid())
  measurementObjectId   String
  type                  MediaType
  url                   String
  thumbnailUrl          String?           // For videos
  duration              Int?              // Duration in seconds for videos
  caption               String?
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  deletedById           String?

  measurementObject     MeasurementObject @relation(fields: [measurementObjectId], references: [id], onDelete: Cascade)

  @@index([measurementObjectId])
  @@index([type])
  @@index([deletedAt])
  @@map("measurement_object_media")
}

enum MeasurementStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

enum MeasurementObjectType {
  // Property Types
  HOUSE
  VILLA
  FLAT
  APARTMENT
  OFFICE
  WAREHOUSE
  SHOP

  // Space/Room Types
  ROOM
  BEDROOM
  KITCHEN
  TOILET
  BATHROOM
  HALL
  LIVING_ROOM
  DINING_ROOM
  PASSAGE
  CORRIDOR
  BALCONY
  TERRACE
  STAIRCASE
  GARAGE
  STORAGE_ROOM
  LAUNDRY_ROOM

  // Furniture
  SOFA
  CHAIR
  TABLE
  BED
  WARDROBE
  CABINET
  SHELF
  DESK
  DRESSER

  // Fixtures
  DOOR
  WINDOW
  CURTAIN
  BLIND
  MIRROR
  LIGHT_FIXTURE

  // Appliances
  AC_UNIT
  REFRIGERATOR
  WASHING_MACHINE
  DISHWASHER
  OVEN
  MICROWAVE
  TV

  // Floor & Wall
  CARPET
  RUG
  MAT
  TILE
  WALLPAPER

  // Outdoor
  GARDEN
  POOL
  PATIO
  FENCE
  GATE

  // Generic/Custom
  ITEM
  OTHER
  CUSTOM
}

enum ObjectSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum SizeMeasurementMode {
  PRESET      // Use preset sizes (S, M, L, etc.)
  DIMENSIONS  // Use custom dimensions (length, width, height)
}

enum MediaType {
  PHOTO
  VIDEO
}

model SiteVisit {
  id               String            @id @default(cuid())
  clientId         String
  scheduledAt      DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  status           SiteVisitStatus   @default(PENDING)
  visitType        VisitType         @default(FULL_HOUSE)
  assignedToId     String
  requiredService  String?
  locationText     String?
  googleMapsUrl    String?
  siteContactName  String?
  siteContactPhone String?
  notes            String?
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deletedById      String?
  measurements     Measurement[]
  photos           Photo[]
  assignedTo       User              @relation(fields: [assignedToId], references: [id])
  client           Client            @relation(fields: [clientId], references: [id])
  scheduleEntries  ScheduleEntry[]
  lead             Lead?             @relation(fields: [leadId], references: [id])
  leadId           String?

  @@index([assignedToId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
  @@map("site_visits")
}

model Photo {
  id                 String            @id @default(cuid())
  siteVisitId        String?
  jobOrderId         String?
  measurementId      String?
  measurementObjectId String?
  phase              PhotoPhase
  url                String
  caption            String?
  description        String?
  uploadedById       String
  createdAt          DateTime          @default(now())
  deletedAt          DateTime?
  deletedById        String?
  jobOrder           JobOrder?         @relation(fields: [jobOrderId], references: [id])
  siteVisit          SiteVisit?        @relation(fields: [siteVisitId], references: [id])
  measurement        Measurement?      @relation(fields: [measurementId], references: [id])
  measurementObject  MeasurementObject? @relation(fields: [measurementObjectId], references: [id])
  uploadedBy         User              @relation(fields: [uploadedById], references: [id])

  @@index([siteVisitId])
  @@index([jobOrderId])
  @@index([measurementId])
  @@index([measurementObjectId])
  @@index([deletedAt])
  @@map("photos")
}

// ============================================
// QUOTATION MODELS
// ============================================

model Quotation {
  id            String          @id @default(cuid())
  clientId      String
  measurementId String?
  version       Int             @default(1) // Multiple versions per client
  createdById   String
  status        QuotationStatus @default(DRAFT)
  validUntil    DateTime?
  notes         String?
  vatEnabled    Boolean         @default(false)
  vatPercentage Decimal         @default(5) @db.Decimal(5, 2)
  discountType  DiscountType?
  discountValue Decimal?        @db.Decimal(10, 3)
  termsTemplateId String?
  termsSnapshot String?
  bankDetailsTemplateId String?
  bankDetailsSnapshot String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  jobOrders     JobOrder[]
  items         QuotationItem[]
  invoices      Invoice[]
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy     User            @relation(fields: [createdById], references: [id])
  measurement   Measurement?    @relation(fields: [measurementId], references: [id])
  termsTemplate TermsTemplate?  @relation(fields: [termsTemplateId], references: [id])
  bankDetailsTemplate BankDetailsTemplate? @relation(fields: [bankDetailsTemplateId], references: [id])
  lead          Lead?           @relation(fields: [leadId], references: [id])
  leadId        String?

  @@index([clientId])
  @@index([status])
  @@index([measurementId])
  @@index([deletedAt])
  @@map("quotations")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  serviceId   String?
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unit        String
  unitPrice   Decimal   @db.Decimal(10, 3)
  total       Decimal   @db.Decimal(10, 3)
  optionGroup String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service     Service?  @relation(fields: [serviceId], references: [id])

  @@index([quotationId])
  @@index([deletedAt])
  @@map("quotation_items")
}

// ============================================
// JOB ORDER MODELS WITH CHECKLIST
// ============================================

model JobOrder {
  id                 String            @id @default(cuid())
  quotationId        String?
  measurementId      String?
  clientId           String
  jobNumber          String            @unique
  status             JobOrderStatus    @default(SCHEDULED)
  paymentStatus      PaymentStatus     @default(UNPAID)
  scheduledDate      DateTime          @db.Date
  scheduledStartTime DateTime?
  scheduledEndTime   DateTime?
  isMultiDay         Boolean           @default(false)
  endDate            DateTime?         @db.Date
  location           String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  deletedById        String?
  assignments        JobAssignment[]
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotation          Quotation?        @relation(fields: [quotationId], references: [id])
  measurement        Measurement?      @relation(fields: [measurementId], references: [id])
  statusUpdates      JobStatusUpdate[]
  photos             Photo[]
  invoices           Invoice[]
  checklistItems     ChecklistItem[]
  equipment         JobEquipment[]
  materials         JobMaterial[]
  scheduleEntries    ScheduleEntry[]

  @@index([status])
  @@index([paymentStatus])
  @@index([scheduledDate])
  @@index([clientId])
  @@index([measurementId])
  @@index([deletedAt])
  @@map("job_orders")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model JobEquipment {
  id              String         @id @default(cuid())
  jobOrderId      String
  equipmentId     String
  quantity        Int            @default(1)
  notes           String?
  jobOrder        JobOrder       @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  equipment       EquipmentMaster @relation(fields: [equipmentId], references: [id])

  @@unique([jobOrderId, equipmentId])
  @@map("job_equipment")
}

model JobMaterial {
  id              String         @id @default(cuid())
  jobOrderId      String
  materialId      String
  quantity        Decimal        @db.Decimal(10, 2)
  notes           String?
  jobOrder        JobOrder       @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  material        MaterialMaster @relation(fields: [materialId], references: [id])

  @@unique([jobOrderId, materialId])
  @@map("job_materials")
}

model ChecklistItem {
  id            String    @id @default(cuid())
  jobOrderId    String
  description   String
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  verifiedById  String?
  photoRequired Boolean   @default(true)
  photoUrl      String?
  notes         String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  jobOrder      JobOrder  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  completedBy   User?     @relation("ChecklistItemCompletedBy", fields: [completedById], references: [id])
  verifiedBy    User?     @relation("ChecklistItemVerifiedBy", fields: [verifiedById], references: [id])

  @@index([jobOrderId])
  @@index([isCompleted])
  @@index([isVerified])
  @@index([deletedAt])
  @@map("checklist_items")
}

model JobAssignment {
  id         String    @id @default(cuid())
  jobOrderId String
  userId     String
  roleInJob  JobRole   @default(CLEANER)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  jobOrder   JobOrder  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobOrderId, userId])
  @@index([userId])
  @@index([deletedAt])
  @@map("job_assignments")
}

model JobStatusUpdate {
  id              String            @id @default(cuid())
  jobOrderId      String
  createdById     String
  status          JobProgressStatus
  progressPercent Int               @default(0)
  note            String?
  createdAt       DateTime          @default(now())
  createdBy       User              @relation(fields: [createdById], references: [id])
  jobOrder        JobOrder          @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  @@index([jobOrderId])
  @@index([createdAt])
  @@map("job_status_updates")
}

// ============================================
// INVOICE & PAYMENT MODELS
// ============================================

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  clientId          String
  jobOrderId        String?
  quotationId       String?
  issueDate         DateTime      @default(now())
  dueDate           DateTime?
  status            InvoiceStatus @default(DRAFT)
  isProforma        Boolean       @default(false)
  currency          String        @default("OMR")
  subtotal          Decimal       @db.Decimal(10, 3)
  tax               Decimal       @default(0) @db.Decimal(10, 3)
  total             Decimal       @db.Decimal(10, 3)
  pdfUrl            String? // Stored PDF path
  sharedViaWhatsApp Boolean       @default(false)
  sharedAt          DateTime?
  notes             String?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  items             InvoiceItem[]
  payments          Payment[]
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy         User          @relation(fields: [createdById], references: [id])
  jobOrder          JobOrder?     @relation(fields: [jobOrderId], references: [id])
  quotation         Quotation?    @relation(fields: [quotationId], references: [id])

  @@index([status])
  @@index([clientId])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(10, 3)
  total       Decimal   @db.Decimal(10, 3)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([deletedAt])
  @@map("invoice_items")
}

model Payment {
  id              String    @id @default(cuid())
  invoiceId       String
  clientId        String
  amount          Decimal   @db.Decimal(10, 3)
  paymentMethod   String // From PaymentMethodMaster
  paymentDate     DateTime  @default(now())
  referenceNumber String?
  notes           String?
  recordedById    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedById     String?
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedBy      User      @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([clientId])
  @@index([paymentDate])
  @@index([deletedAt])
  @@map("payments")
}

// ============================================
// ADDITIONAL MODELS
// ============================================

model CustomerNote {
  id           String    @id @default(cuid())
  clientId     String
  leadId       String?
  jobOrderId   String?
  content      String
  isReminder   Boolean   @default(false)
  reminderDate DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User      @relation(fields: [createdById], references: [id])

  @@index([clientId])
  @@index([createdById])
  @@index([reminderDate])
  @@index([deletedAt])
  @@map("customer_notes")
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  services    Service[]

  @@index([deletedAt])
  @@map("service_categories")
}

model Service {
  id           String               @id @default(cuid())
  categoryId   String
  name         String
  slug         String               @unique
  description  String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  quoteItems   QuotationItem[]
  pricingRules ServicePricingRule[]
  category     ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([deletedAt])
  @@map("services")
}

model ServicePricingRule {
  id          String      @id @default(cuid())
  serviceId   String
  pricingType PricingType
  unitLabel   String
  basePrice   Decimal     @db.Decimal(10, 3)
  currency    String      @default("OMR")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  deletedById String?
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([deletedAt])
  @@map("service_pricing_rules")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  deletedById String?
  users       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model User {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  phone                String?
  whatsapp             String?
  hashedPassword       String
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  deletedById          String?
  jobAssignments       JobAssignment[]
  statusUpdates        JobStatusUpdate[]
  leads                Lead[]
  photos               Photo[]
  quotations           Quotation[]
  siteVisits           SiteVisit[]
  roles                UserRole[]
  invoices             Invoice[]
  payments             Payment[]
  customerNotes        CustomerNote[]
  completedChecklistItems ChecklistItem[] @relation("ChecklistItemCompletedBy")
  verifiedChecklistItems ChecklistItem[] @relation("ChecklistItemVerifiedBy")
  auditLogs            AuditLog[]
  deletedRecords       DeletedRecord[]         @relation("DeletedBy")
  restoredRecords      DeletedRecord[]         @relation("RestoredBy")
  notificationSettings NotificationSetting?
  notificationQueueItems NotificationQueue[]
  notifications        Notification[]
  createdScheduleEntries ScheduleEntry[]
  assignedScheduleEntries ScheduleEntryAssignee[]
  scheduleReminders    ScheduleReminder[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// NOTIFICATION MODELS
// ============================================

model Notification {
  id           String      @id @default(cuid())
  recipientUserId String?
  recipientRole   String?
  title        String
  message      String
  entityType   String?
  entityId     String?
  isRead       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  readAt       DateTime?
  recipient    User?       @relation(fields: [recipientUserId], references: [id])

  @@index([recipientUserId])
  @@index([recipientRole])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  reminders Json     // e.g. { job_scheduled: { email: true, sms: false }, job_reminder_30min: { push: true } }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

model NotificationQueue {
  id          String    @id @default(cuid())
  userId      String
  type        String    // e.g. "JOB_REMINDER"
  channel     String    // e.g. "PUSH", "EMAIL", "SMS"
  sendAt      DateTime
  sentAt      DateTime?
  payload     Json
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  error       String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([sendAt, status])
  @@map("notification_queue")
}

// ============================================
// TEMPLATE MODELS
// ============================================

model TermsTemplate {
  id          String      @id @default(cuid())
  name        String      @unique
  content     String
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  deletedById String?
  quotations  Quotation[]

  @@index([deletedAt])
  @@map("terms_templates")
}

model BankDetailsTemplate {
  id          String      @id @default(cuid())
  name        String      @unique
  content     String
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  deletedById String?
  quotations  Quotation[]

  @@index([deletedAt])
  @@map("bank_details_templates")
}

